{
  "name": "besedki-emin-phone",
  "version": "1.0.0",
  "description": "Desktop SIP Phone для Besedki EMIN",
  "main": "electron/main.js",
  "scripts": {
    "electron:dev": "electron .",
    "electron:build": "electron-builder"
  },
  "dependencies": {
    "sip.js": "^0.21.2",
    "dgram": "^1.0.1",
    "net": "^1.0.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.besedki.phone",
    "productName": "Besedki EMIN Phone",
    "directories": {
      "output": "dist-electron"
    },
    "mac": {
      "category": "public.app-category.business"
    },
    "win": {
      "target": "nsis"
    }
  }
}
