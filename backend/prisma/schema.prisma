// Prisma Schema для Production Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// ДИНАМИЧЕСКИЕ РОЛИ
// =============================================

// Роли пользователей (настраиваемые)
model Role {
  id          String  @id @default(uuid())
  name        String  @unique // Название роли ("Менеджер", "Маляр" и т.д.)
  code        String  @unique // Код роли для программной идентификации (MANAGER, PAINTER)
  description String? // Описание роли
  color       String? // Цвет для UI (#3B82F6)
  isSystem    Boolean @default(false) @map("is_system") // Системные роли нельзя удалить
  isActive    Boolean @default(true) @map("is_active")
  order       Int     @default(0) // Для сортировки

  // Дополнительные права доступа (JSON массив строк)
  // Например: ["users:view", "analytics:view", "orders:create"]
  permissions Json @default("[]")

  // Связь с пользователями
  users User[]

  // Связь с этапами workflow (многие-ко-многим)
  workflowStages RoleWorkflowStage[]

  // Настройки комиссии для роли
  managerCommissions ManagerCommission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

// Связь роли с этапами workflow (многие-ко-многим)
model RoleWorkflowStage {
  id              String @id @default(uuid())
  roleId          String @map("role_id")
  workflowStageId String @map("workflow_stage_id")

  role          Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  workflowStage WorkflowStage @relation(fields: [workflowStageId], references: [id], onDelete: Cascade)

  @@unique([roleId, workflowStageId])
  @@map("role_workflow_stages")
}

// Статусы заказа
enum OrderStatus {
  NEW // Новый заказ
  IN_PRODUCTION // В производстве
  COMPLETED // Завершен
  CANCELLED // Отменен
}

// Приоритет заказа
enum OrderPriority {
  LOW // Низкий приоритет
  NORMAL // Обычный приоритет
  HIGH // Высокий приоритет
  URGENT // Срочный
}

// Этапы производства продукта
enum ProductionStage {
  PENDING // Ожидает начала
  DESIGN // Проектирование
  PREPARATION // Заготовка
  PAINTING // Покраска
  SEWING // Пошив (для продуктов с обивкой)
  ASSEMBLY // Сборка
  QUALITY_CHECK // Проверка качества на складе
  COMPLETED // Завершено
  REJECTED // Брак
}

// Статус проверки качества
enum QualityStatus {
  PENDING // Ожидает проверки
  APPROVED // Принято
  REJECTED // Забраковано
}

// Статус задачи
enum TaskStatus {
  NEW // Новая задача
  ACCEPTED // Принята в работу
  COMPLETED // Завершена
  PASSED // Передана дальше
  REJECTED // Брак (только для складиста)
}

// Приоритет задачи
enum TaskPriority {
  LOW // Низкий приоритет
  NORMAL // Обычный приоритет
  HIGH // Высокий приоритет
  URGENT // Срочный
}

// Тип оплаты сотрудника
enum PaymentType {
  PIECE_RATE // Сдельная оплата (по расценкам за изделие)
  SALARY     // Оклад (фиксированная зарплата, только учёт выработки)
}

// Статус отгрузки со склада
enum ShipmentStatus {
  PENDING // Ожидает отгрузки
  IN_TRANSIT // В пути
  DELIVERED // Доставлено
  CANCELLED // Отменено
}

// Пользователи системы
model User {
  id        String  @id @default(uuid())
  email     String  @unique
  password  String
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  isActive            Boolean @default(true) @map("is_active")
  isDepartmentAccount Boolean @default(false) @map("is_department_account")

  // Связь с ролью (динамические роли)
  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id])

  // Тип оплаты: сдельная или оклад
  paymentType   PaymentType @default(PIECE_RATE) @map("payment_type")
  // Оклад (только для paymentType = SALARY), руб/мес
  monthlySalary Float?      @map("monthly_salary")

  // PIN-код для быстрого входа производственных работников (хранится в виде хеша bcrypt)
  pin String? @map("pin")

  // Telegram для уведомлений
  telegramId String? @map("telegram_id")

  // SIP телефония (для менеджеров)
  sipServer   String? @map("sip_server") // SIP сервер (например, sip.example.com)
  sipUser     String? @map("sip_user") // Логин для SIP
  sipPassword String? @map("sip_password") // Пароль для SIP
  sipPort     Int?    @default(5060) @map("sip_port") // Порт SIP (по умолчанию 5060)
  sipWsPort   Int?    @default(8089) @map("sip_ws_port") // Порт WebSocket для SIP (Yeastar S100 использует 8089)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Заказы созданные менеджером
  ordersCreated  Order[]
  // История работы с продуктами
  productHistory ProductHistory[]
  // Проверки качества
  qualityChecks  QualityCheck[]
  // Ежедневные задачи
  tasks          Task[]
  // Отгрузки оформленные складистом
  shipments      Shipment[]

  // Расчет зарплаты
  workLogs          WorkLog[]
  penalties         Penalty[]
  penaltiesCreated  Penalty[]          @relation("PenaltyCreatedBy")
  payrollPeriods    PayrollPeriod[]
  managerCommission ManagerCommission?

  @@index([roleId])
  @@index([isActive])
  @@map("users")
}

// Источники заказов (справочник)
model OrderSource {
  id          String  @id @default(uuid())
  name        String  @unique // Название источника (Авито, Инстаграм, и т.д.)
  code        String  @unique // Код для программной идентификации (AVITO, INSTAGRAM)
  description String? // Описание
  color       String? // Цвет для UI (#3B82F6)
  icon        String? // Иконка (имя иконки или emoji)
  isActive    Boolean @default(true) @map("is_active")
  order       Int     @default(0) // Для сортировки

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Заказы из этого источника
  orders Order[]

  @@map("order_sources")
}

// Заказы
model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique @map("order_number")
  customerName    String        @map("customer_name")
  customerPhone   String?       @map("customer_phone")
  customerAddress String?       @map("customer_address")
  status          OrderStatus   @default(NEW)
  priority        OrderPriority @default(NORMAL)
  description     String?
  notes           String?

  // Источник заказа
  sourceId String?      @map("source_id")
  source   OrderSource? @relation(fields: [sourceId], references: [id])

  // Сумма заказа (для расчета комиссии менеджера)
  totalAmount Float? @map("total_amount")

  createdById String @map("created_by_id")
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Продукты в заказе
  products       Product[]
  // Складские остатки из этого заказа
  inventoryItems InventoryItem[]

  @@index([status])
  @@index([createdAt])
  @@index([createdById])
  @@index([sourceId])
  @@map("orders")
}

// Типы продуктов (настраиваемые менеджером)
model ProductType {
  id          String  @id @default(uuid())
  name        String  @unique // Название типа (Стол, Стул, и т.д.)
  description String? // Описание типа
  isActive    Boolean @default(true) @map("is_active") // Активен ли тип

  // Нормативное время производства (в часах)
  productionTimeHours Float? @map("production_time_hours")

  // Требуется ли этап пошива для этого типа продукта
  requiresSewing Boolean @default(false) @map("requires_sewing")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Продукты этого типа
  products       Product[]
  // Складские остатки этого типа
  inventoryItems InventoryItem[]
  // Номенклатура этого типа
  nomenclatures  Nomenclature[]
  // Расценки за работу
  workRates      WorkRate[]
  // Журнал работ
  workLogs       WorkLog[]

  @@map("product_types")
}

// Номенклатура товаров (конкретные модели внутри типа)
model Nomenclature {
  id          String  @id @default(uuid())
  name        String // Название номенклатуры (например, "Беседка 3x3", "Стол круглый")
  sku         String? @unique // Артикул
  description String? // Описание

  // Связь с типом товара
  productTypeId String      @map("product_type_id")
  productType   ProductType @relation(fields: [productTypeId], references: [id])

  // Характеристики
  dimensions         String? // Размеры (например, "3x3 м", "120x80 см")
  materials          String? // Материалы
  color              String? // Цвет/покрытие
  upholsteryMaterial String? @map("upholstery_material") // Материал обшивки (ткань/кожа)
  weight             Float? // Вес в кг

  // Цены
  basePrice Float? @map("base_price") // Базовая цена

  // Нормативное время производства (в часах), переопределяет время из типа
  productionTimeHours Float? @map("production_time_hours")

  isActive       Boolean   @default(true) @map("is_active")
  discontinuedAt DateTime? @map("discontinued_at") // Дата прекращения выпуска

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Продукты этой номенклатуры
  products Product[]
  // Расценки за работу по этому изделию
  workRates WorkRate[]

  @@map("nomenclatures")
}

// Настраиваемые этапы производства (для владельца)
model WorkflowStage {
  id          String  @id @default(uuid())
  name        String // Название этапа (например, "Менеджер", "Заготовка", "Маляр")
  description String? // Описание этапа
  order       Int // Порядковый номер этапа (1, 2, 3...)
  isActive    Boolean @default(true) @map("is_active")

  // Старое значение ProductionStage для совместимости
  legacyStage ProductionStage? @map("legacy_stage")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Роли, которые могут работать на этом этапе (многие-ко-многим)
  roles RoleWorkflowStage[]

  // История прохождения продуктов через этот этап
  productHistory ProductHistory[]
  // Задачи на этом этапе
  tasks          Task[]
  // Расценки за работу
  workRates      WorkRate[]
  // Журнал работ
  workLogs       WorkLog[]

  @@unique([order])
  @@map("workflow_stages")
}

// Продукты (каждый проходит свой цикл)
model Product {
  id             String          @id @default(uuid())
  name           String // Название продукта
  description    String?
  quantity       Int             @default(1) // Количество
  dimensions     String? // Размеры продукта (например, "100x50x75 см")
  schemaImageUrl String?         @map("schema_image_url") // URL к фото схемы для производственников
  stage          ProductionStage @default(PENDING)

  // Дедлайн
  deadline DateTime?

  // Тип продукта
  productTypeId String      @map("product_type_id")
  productType   ProductType @relation(fields: [productTypeId], references: [id])

  // Требуется ли пошив (если null - берётся из типа продукта)
  requiresSewing Boolean? @map("requires_sewing")

  // Цвет/покрытие (для маляра)
  color String?

  // Материал обшивки (ткань/кожа) - если указан, автоматически включается пошив
  upholsteryMaterial String? @map("upholstery_material")

  // Назначения работников на этапы {stage: userId}
  stageAssignments Json? @map("stage_assignments")

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Связь с номенклатурой (конкретная модель изделия)
  nomenclatureId String?       @map("nomenclature_id")
  nomenclature   Nomenclature? @relation(fields: [nomenclatureId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // История прохождения этапов
  history        ProductHistory[]
  // Проверки качества
  qualityChecks  QualityCheck[]
  // Ежедневные задачи
  tasks          Task[]
  // Складские остатки
  inventoryItems InventoryItem[]
  // Журнал работ
  workLogs       WorkLog[]
  // Штрафы за брак
  penalties      Penalty[]

  @@index([stage])
  @@index([orderId])
  @@index([productTypeId])
  @@index([nomenclatureId])
  @@map("products")
}

// История прохождения продукта по этапам
model ProductHistory {
  id          String          @id @default(uuid())
  stage       ProductionStage // Этап (старый для совместимости)
  status      TaskStatus      @default(NEW) // Статус задачи на этом этапе
  startedAt   DateTime        @default(now()) @map("started_at")
  completedAt DateTime?       @map("completed_at")
  passedAt    DateTime?       @map("passed_at") // Когда передано дальше
  notes       String? // Заметки

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Кто работал на этом этапе
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  // Связь с настраиваемым этапом workflow
  workflowStageId String?        @map("workflow_stage_id")
  workflowStage   WorkflowStage? @relation(fields: [workflowStageId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId, stage])
  @@index([userId])
  @@map("product_history")
}

// Проверка качества (складист проверяет)
model QualityCheck {
  id        String        @id @default(uuid())
  status    QualityStatus @default(PENDING)
  notes     String? // Причина браковки
  photoUrl  String?       @map("photo_url") // URL фото брака
  checkedAt DateTime?     @map("checked_at")

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Складист который проверял
  checkedById String? @map("checked_by_id")
  checkedBy   User?   @relation(fields: [checkedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId, status])
  @@map("quality_checks")
}

// Ежедневные задачи для каждой роли
model Task {
  id          String          @id @default(uuid())
  title       String // Название задачи
  description String? // Описание
  status      TaskStatus      @default(NEW) // Статус задачи
  stage       ProductionStage // Этап производства (старый для совместимости)
  quantity    Int             @default(0) // Количество (для складиста при приемке)

  // Приоритет задачи
  priority TaskPriority @default(NORMAL) // Приоритет задачи

  // Даты
  acceptedAt  DateTime? @map("accepted_at") // Когда принята в работу
  completedAt DateTime? @map("completed_at") // Когда завершена
  passedAt    DateTime? @map("passed_at") // Когда передана дальше
  rejectedAt  DateTime? @map("rejected_at") // Когда забракована

  // Примечания (например, причина брака)
  notes String?

  // Фото брака (для складиста при браковке) - массив URL для нескольких фото
  defectPhotos String[] @default([]) @map("defect_photos")

  // Количество уже обработанное (принято или забраковано)
  quantityProcessed Int @default(0) @map("quantity_processed")

  // Связь с продуктом
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Кому назначена задача (работник)
  assignedToId String @map("assigned_to_id")
  assignedTo   User   @relation(fields: [assignedToId], references: [id])

  // Связь с настраиваемым этапом workflow
  workflowStageId String?        @map("workflow_stage_id")
  workflowStage   WorkflowStage? @relation(fields: [workflowStageId], references: [id])

  // Журнал работ (записи о выполнении)
  workLogs WorkLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([assignedToId, stage])
  @@index([productId, status])
  @@index([productId, assignedToId])
  @@index([status])
  @@index([stage, status])
  @@map("tasks")
}

// Складские остатки (товары на складе)
model InventoryItem {
  id       String @id @default(uuid())
  name     String // Название товара (копия из продукта или введённое вручную)
  quantity Int    @default(0) // Текущее количество на складе

  // Связь с продуктом (из какого продукта поступило) - опционально для ручного добавления
  productId String?  @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Связь с типом продукта
  productTypeId String      @map("product_type_id")
  productType   ProductType @relation(fields: [productTypeId], references: [id])

  // Из какого заказа поступило - опционально для ручного добавления
  orderId String? @map("order_id")
  order   Order?  @relation(fields: [orderId], references: [id])

  // Дата поступления на склад
  receivedAt DateTime @default(now()) @map("received_at")

  // Примечания
  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Позиции отгрузок этого товара
  shipmentItems ShipmentItem[]

  @@index([productTypeId])
  @@index([orderId])
  @@index([productId])
  @@map("inventory_items")
}

// Отгрузки со склада (списание на доставку)
model Shipment {
  id     String         @id @default(uuid())
  status ShipmentStatus @default(PENDING)

  // Номер заказа (опционально - может быть введён вручную или привязан к заказу)
  orderNumber String? @map("order_number")

  // Позиции отгрузки (несколько товаров)
  items ShipmentItem[]

  // Информация о доставке
  customerName    String    @map("customer_name")
  customerPhone   String    @map("customer_phone")
  deliveryAddress String    @map("delivery_address")
  deliveryDate    DateTime? @map("delivery_date") // Планируемая дата доставки

  // Кто оформил отгрузку (складист, менеджер или владелец)
  shippedById String @map("shipped_by_id")
  shippedBy   User   @relation(fields: [shippedById], references: [id])

  // Примечания
  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([shippedById])
  @@map("shipments")
}

// Позиции отгрузки (товары в отгрузке)
model ShipmentItem {
  id       String @id @default(uuid())
  quantity Int // Количество списываемого товара

  // Связь с отгрузкой
  shipmentId String   @map("shipment_id")
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  // Связь со складским остатком
  inventoryItemId String        @map("inventory_item_id")
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("shipment_items")
}

// Настройки компании (для путевых листов, документов и т.д.)
model CompanySettings {
  id String @id @default(uuid())

  // Основная информация
  companyName     String @map("company_name")
  phone           String @default("")
  email           String @default("")
  address         String @default("")
  website         String @default("")
  supportTelegram String @default("") @map("support_telegram")

  // Юридическая информация
  inn      String @default("")
  director String @default("")

  // Банковские реквизиты
  bank          String @default("")
  bik           String @default("")
  accountNumber String @default("") @map("account_number")

  // Логотип компании
  logoUrl String? @map("logo_url")

  // Рабочие часы для онлайн-чата
  chatEnabled       Boolean @default(true) @map("chat_enabled") // Включен ли чат
  workingHoursStart String  @default("08:00") @map("working_hours_start") // Начало рабочего дня (формат HH:mm)
  workingHoursEnd   String  @default("18:00") @map("working_hours_end") // Конец рабочего дня (формат HH:mm)
  workingDays       String  @default("1,2,3,4,5") @map("working_days") // Рабочие дни (1=пн, 7=вс), через запятую
  timezone          String  @default("Europe/Moscow") // Часовой пояс
  offlineMessage    String  @default("Мы сейчас не в сети. Оставьте заявку на звонок, и мы свяжемся с вами!") @map("offline_message")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

// =============================================
// ПУБЛИЧНЫЙ КАТАЛОГ ТОВАРОВ
// =============================================

// Категории товаров для публичного каталога
model CatalogCategory {
  id          String  @id @default(uuid())
  name        String // Название категории (например, "Беседки", "Арки и павильоны")
  slug        String  @unique // URL-slug для SEO
  description String? // Описание категории
  imageUrl    String? @map("image_url") // Изображение категории
  order       Int     @default(0) // Порядок отображения
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Товары в этой категории
  products CatalogProduct[]

  @@map("catalog_categories")
}

// Товары для публичного каталога
model CatalogProduct {
  id          String  @id @default(uuid())
  name        String // Название товара
  slug        String  @unique // URL-slug для SEO
  description String? // Полное описание товара
  shortDesc   String? @map("short_desc") // Краткое описание

  // Изображения (первое - основное)
  images String[] // Массив URL изображений

  // Характеристики
  dimensions String? // Размеры
  material   String? // Материал
  price      Float? // Цена (может не быть, если по запросу)
  priceNote  String? @map("price_note") // Примечание к цене (например, "от 50000 руб")

  // Дополнительные характеристики (JSON)
  features Json? // Любые дополнительные характеристики

  // SEO
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")
  metaKeywords    String? @map("meta_keywords")

  order      Int     @default(0) // Порядок отображения
  isActive   Boolean @default(true) @map("is_active")
  isFeatured Boolean @default(false) @map("is_featured") // Рекомендуемый товар

  // Связь с категорией
  categoryId String          @map("category_id")
  category   CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Заказы этого товара
  orderItems CatalogOrderItem[]

  @@map("catalog_products")
}

// Статус заказа с сайта
enum CatalogOrderStatus {
  NEW // Новый заказ
  CONTACTED // Связались с клиентом
  IN_WORK // В работе
  COMPLETED // Выполнен
  CANCELLED // Отменен
}

// Заказы с публичного сайта
model CatalogOrder {
  id            String             @id @default(uuid())
  orderNumber   String             @unique @map("order_number") // Номер заказа
  customerName  String             @map("customer_name")
  customerPhone String             @map("customer_phone")
  customerEmail String?            @map("customer_email")
  comment       String? // Комментарий к заказу
  status        CatalogOrderStatus @default(NEW)

  // Адрес доставки
  deliveryAddress String? @map("delivery_address")

  // Итоговая сумма
  totalAmount Float? @map("total_amount")

  // Отслеживание действий менеджера
  contactedAt DateTime? @map("contacted_at") // Когда менеджер связался с клиентом
  contactedBy String?   @map("contacted_by") // ID менеджера, который связался
  processedAt DateTime? @map("processed_at") // Когда заказ был оформлен/обработан
  processedBy String?   @map("processed_by") // ID менеджера, который оформил

  // Причина отмены заказа
  cancellationReason String? @map("cancellation_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Позиции заказа
  items CatalogOrderItem[]

  // Чат-комната для общения с клиентом
  chatRoom ChatRoom?

  @@map("catalog_orders")
}

// Позиции заказа с сайта
model CatalogOrderItem {
  id       String  @id @default(uuid())
  quantity Int     @default(1)
  price    Float? // Цена на момент заказа
  comment  String? // Комментарий к позиции

  // Связь с заказом
  orderId String       @map("order_id")
  order   CatalogOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Связь с товаром
  productId String         @map("product_id")
  product   CatalogProduct @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("catalog_order_items")
}

// Запросы обратной связи с сайта
model ContactRequest {
  id          String    @id @default(uuid())
  name        String // Имя клиента
  phone       String // Телефон
  email       String? // Email (опционально)
  message     String // Сообщение
  productId   String?   @map("product_id") // Если запрос о конкретном товаре
  isProcessed Boolean   @default(false) @map("is_processed") // Обработан ли запрос
  processedAt DateTime? @map("processed_at") // Когда обработан
  notes       String? // Примечания менеджера

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contact_requests")
}

// =============================================
// ОНЛАЙН ЧАТ С КЛИЕНТАМИ
// =============================================

// Комната чата (может быть гостевая или привязана к заказу)
model ChatRoom {
  id String @id @default(uuid())

  // Опциональная связь с заказом (если клиент оформил заказ)
  catalogOrderId String?       @unique @map("catalog_order_id")
  catalogOrder   CatalogOrder? @relation(fields: [catalogOrderId], references: [id], onDelete: Cascade)

  // Информация о клиенте (для гостевых сессий)
  customerName   String  @map("customer_name") // Имя клиента
  customerPhone  String? @map("customer_phone") // Телефон для идентификации
  customerEmail  String? @map("customer_email") // Email для идентификации
  guestSessionId String? @unique @map("guest_session_id") // Уникальный ID сессии гостя

  isActive Boolean @default(true) @map("is_active") // Активна ли комната

  // Последнее сообщение для превью
  lastMessageAt   DateTime? @map("last_message_at")
  lastMessageText String?   @map("last_message_text")

  // Непрочитанные сообщения для менеджера
  unreadCount Int @default(0) @map("unread_count")

  messages ChatMessage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([guestSessionId])
  @@index([customerPhone])
  @@index([customerEmail])
  @@map("chat_rooms")
}

// Сообщение в чате
model ChatMessage {
  id     String   @id @default(uuid())
  roomId String   @map("room_id")
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  // Отправитель
  senderType String  @map("sender_type") // "CUSTOMER" | "MANAGER"
  senderId   String? @map("sender_id") // userId для менеджера, null для клиента
  senderName String  @map("sender_name") // Имя отправителя для отображения

  // Контент
  content String // Текст сообщения

  // Статус
  isRead Boolean   @default(false) @map("is_read")
  readAt DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([roomId, createdAt])
  @@index([roomId, isRead, senderType])
  @@map("chat_messages")
}

// Заявка на обратный звонок (для нерабочего времени)
model CallbackRequest {
  id      String  @id @default(uuid())
  name    String // Имя клиента
  phone   String // Телефон
  message String? // Дополнительное сообщение

  // Связь с заказом (если есть)
  catalogOrderId String? @map("catalog_order_id")

  // Предпочтительное время звонка
  preferredTime String? @map("preferred_time") // Например: "09:00-12:00" или "После 15:00"

  // Статус обработки
  status      String    @default("NEW") // "NEW" | "CONTACTED" | "COMPLETED" | "CANCELLED"
  processedBy String?   @map("processed_by") // ID менеджера
  processedAt DateTime? @map("processed_at")
  notes       String? // Примечания менеджера

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("callback_requests")
}

// =============================================
// УПРАВЛЕНИЕ ФУНКЦИОНАЛЬНОСТЬЮ (FEATURE FLAGS)
// =============================================

// Флаги функций для супер-админа (OWNER)
model FeatureFlag {
  id          String  @id @default(uuid())
  key         String  @unique // Уникальный ключ фичи (например: "chat", "catalog", "analytics")
  name        String // Название функции для отображения
  description String? // Описание функции
  isEnabled   Boolean @default(true) @map("is_enabled") // Включена ли функция
  category    String  @default("general") // Категория (general, production, sales, etc.)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

// =============================================
// РАСЧЕТ ЗАРПЛАТЫ
// =============================================

// Статус расчетного периода
enum PayrollStatus {
  DRAFT // Черновик (можно редактировать)
  APPROVED // Утвержден (ожидает выплаты)
  PAID // Выплачен
  CANCELLED // Отменен
}

// Расценки за работу (цена за изделие по типу/этапу или по номенклатуре)
model WorkRate {
  id String @id @default(uuid())

  // Тип продукта (опционально, если не указана номенклатура)
  productTypeId String?      @map("product_type_id")
  productType   ProductType? @relation(fields: [productTypeId], references: [id])

  // Номенклатура (конкретное изделие) - приоритет над типом
  nomenclatureId String?       @map("nomenclature_id")
  nomenclature   Nomenclature? @relation(fields: [nomenclatureId], references: [id])

  // Этап производства (старый enum для совместимости)
  stage ProductionStage

  // Этап workflow (новый, опционально)
  workflowStageId String?        @map("workflow_stage_id")
  workflowStage   WorkflowStage? @relation(fields: [workflowStageId], references: [id])

  // Цена за единицу изделия на этом этапе
  pricePerUnit Float @map("price_per_unit")

  // Описание (например "Покраска беседки 3x3")
  description String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([nomenclatureId, stage]) // Уникальная расценка по номенклатуре+стадии
  @@unique([productTypeId, stage, nomenclatureId]) // Уникальная расценка по типу+стадии (когда nomenclatureId=null)
  @@map("work_rates")
}

// Журнал выполненных работ (автоматически создается при завершении задачи)
model WorkLog {
  id String @id @default(uuid())

  // Работник
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  // Продукт
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  // Задача (опционально, для связи)
  taskId String? @map("task_id")
  task   Task?   @relation(fields: [taskId], references: [id])

  // Тип продукта (для быстрого доступа)
  productTypeId String      @map("product_type_id")
  productType   ProductType @relation(fields: [productTypeId], references: [id])

  // Этап производства
  stage ProductionStage

  // Этап workflow (опционально)
  workflowStageId String?        @map("workflow_stage_id")
  workflowStage   WorkflowStage? @relation(fields: [workflowStageId], references: [id])

  // Количество обработанных единиц
  quantity Int @default(1)

  // Цена за единицу (на момент выполнения работы)
  pricePerUnit Float @map("price_per_unit")

  // Итоговая сумма (quantity * pricePerUnit)
  totalAmount Float @map("total_amount")

  // Когда работа выполнена
  completedAt DateTime @map("completed_at")

  // Примечания
  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Связь с расчетным периодом
  payrollPeriodId String?        @map("payroll_period_id")
  payrollPeriod   PayrollPeriod? @relation(fields: [payrollPeriodId], references: [id])

  @@index([userId, completedAt])
  @@index([productTypeId, stage])
  @@index([completedAt])
  @@index([payrollPeriodId])
  @@map("work_logs")
}

// Штрафы
model Penalty {
  id String @id @default(uuid())

  // Работник, которому назначен штраф
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  // Сумма штрафа
  amount Float

  // Причина штрафа
  reason String

  // За какой продукт (опционально - для брака)
  productId String?  @map("product_id")
  product   Product? @relation(fields: [productId], references: [id])

  // Кто назначил штраф
  createdById String @map("created_by_id")
  createdBy   User   @relation("PenaltyCreatedBy", fields: [createdById], references: [id])

  // Дата штрафа
  date DateTime @default(now())

  // Примечания
  notes String?

  // Отменен ли штраф
  isCancelled   Boolean   @default(false) @map("is_cancelled")
  cancelledAt   DateTime? @map("cancelled_at")
  cancelledById String?   @map("cancelled_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Связь с расчетным периодом
  payrollPeriodId String?        @map("payroll_period_id")
  payrollPeriod   PayrollPeriod? @relation(fields: [payrollPeriodId], references: [id])

  @@index([userId, date])
  @@map("penalties")
}

// Расчетный период (ведомость на зарплату)
model PayrollPeriod {
  id String @id @default(uuid())

  // Работник
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  // Период расчета
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  // Базовый оклад (для менеджеров)
  baseSalary Float @default(0) @map("base_salary")

  // Сумма за работу (для производственников)
  workAmount Float @default(0) @map("work_amount")

  // Комиссия с заказов (для менеджеров)
  commissionAmount Float @default(0) @map("commission_amount")

  // Сумма заказов менеджера за период (для расчета комиссии)
  ordersAmount Float @default(0) @map("orders_amount")

  // Сумма штрафов
  penaltyAmount Float @default(0) @map("penalty_amount")

  // Итого к выплате
  totalAmount Float @default(0) @map("total_amount")

  // Статус
  status PayrollStatus @default(DRAFT)

  // Кто утвердил/выплатил
  approvedById String?   @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  paidById     String?   @map("paid_by_id")
  paidAt       DateTime? @map("paid_at")

  // Примечания
  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Связанные записи
  workLogs  WorkLog[]
  penalties Penalty[]

  @@unique([userId, periodStart, periodEnd])
  @@index([userId, status])
  @@index([periodStart, periodEnd])
  @@map("payroll_periods")
}

// Настройки комиссии менеджера
model ManagerCommission {
  id String @id @default(uuid())

  // Менеджер (если для конкретного пользователя)
  userId String? @unique @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  // Или роль (если для всей роли)
  roleId String? @map("role_id")
  role   Role?   @relation(fields: [roleId], references: [id])

  // Базовый оклад
  baseSalary Float @default(0) @map("base_salary")

  // Процент комиссии от суммы заказов
  commissionPercent Float @default(0) @map("commission_percent")

  // Минимальная сумма заказа для комиссии
  minOrderAmount Float? @map("min_order_amount")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("manager_commissions")
}